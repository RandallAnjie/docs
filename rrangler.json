{
  "name": "rdocs",
  "main": "dist/worker.js",
  "compatibilityDate": "2026-08-14",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rdocs-db"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "rdocs-attachments"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DOCUMENTROOM",
        "class_name": "DocumentRoom"
      }
    ]
  },
  "vars": {
    "APP_ORIGIN": "https://docs.bigrandall.io",
    "AUTH_MODE": "passkey",
    "ENVIRONMENT": "production",
    "PASSKEY_ORIGIN": "https://docs.bigrandall.io",
    "PASSKEY_RP_ID": "docs.bigrandall.io",
    "AI_API_BASE": "https://token.bigrandall.io/v1",
    "MAIL_FROM": "noreply@rf.bigrandall.io"
  },
  "send_email": [{ "name": "EMAIL" }],
  "triggers": { "crons": ["* * * * *"] },
  "publish": true
}
